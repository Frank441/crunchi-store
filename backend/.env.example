# MongoDB (usuarios y productos).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crunchi

# Redis (sesiones de usuario).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Duración de la sesión en segundos (1800 = 30 min).
SESSION_TTL=1800

# Neo4J.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Cassandra
CASSANDRA_NODES=127.0.0.1


# Frontend con CORS (cookie httpOnly).
FRONTEND_ORIGIN=http://localhost:3000